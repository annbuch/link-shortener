# Строка подключения MongoDB Atlas.
# Вариант 1 (обычно): SRV-строка из Connect → Drivers.
# Замените <username>, <password> и имя кластера на свои значения.
# Если в пароле есть символы @ : / ? # [ ] %, их нужно закодировать (URL-encode).
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/clickme?retryWrites=true&w=majority

# Вариант 2 (если querySrv ETIMEOUT/ECONNREFUSED или блокируется TXT):
# стандартная строка с тремя хостами и replicaSet.
# MONGO_URI=mongodb://<username>:<password>@<host-00>:27017,<host-01>:27017,<host-02>:27017/clickme?tls=true&replicaSet=<replica-set>&authSource=admin&retryWrites=true&w=majority

# Порт Mongo-сервиса (PostgreSQL-бэкенд занимает 3000)
PORT=3001

# Базовый адрес для коротких ссылок
BASE_URL=http://localhost:3001

# Владелец по умолчанию для ссылок/групп, если ownerId не передан
DEMO_OWNER_EMAIL=demo@click.me

# CORS
CORS_ORIGIN=http://localhost:5173

# Гео-заглушка для записи кликов (как в PostgreSQL-версии)
DEFAULT_COUNTRY=BY
DEFAULT_CITY=Минск

# Если Node выдаёт querySrv ETIMEOUT/ECONNREFUSED (VPN/локальный DNS),
# явно задайте DNS-серверы. На обычных сетях эту строку можно не менять.
DNS_SERVERS=8.8.8.8,1.1.1.1
