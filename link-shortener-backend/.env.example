DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=clickme_dev
DB_USER=postgres
DB_PASS=postgres

# Аутентификация
JWT_SECRET=your_jwt_secret_change_me
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_refresh_secret_change_me
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Включать sequelize.sync() при старте (только для отладки, схему держат миграции)
DB_SYNC=false